rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gallery collection works
    match /artifacts/{appId}/public/data/gallery/{workId} {
      // Disallow read, update, delete (client read operations completely removed)
      allow read, update, delete: if false;

      // Allow create only: authenticated anonymous user and strictly whitelisted fields
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'displacementUrl',
          'effectValues',
          'vaseShape',
          'timestamp',
          'thumbnailUrl',
          'imageUrls',
          'mode',
          'signatureUrl'
        ]);
    }
    
    // Disallow all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
