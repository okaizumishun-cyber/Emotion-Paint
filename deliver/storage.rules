rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Gallery artwork files
    match /artifacts/{appId}/public/data/gallery/{workId}/{allPaths=**} {
      // Public read required for Instagram Graph API download
      allow read: if true;

      // Allow create only: authenticated anonymous user, image files only, max 5MB
      allow create: if request.auth != null
        && request.resource.contentType.matches('image/(jpeg|png)')
        && request.resource.size < 5 * 1024 * 1024;

      // Disallow update and delete
      allow update, delete: if false;
    }
    
    // Disallow all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
